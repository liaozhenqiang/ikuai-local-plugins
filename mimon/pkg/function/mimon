#!/bin/bash /etc/ikcommon
#
# function/mimon —— Web 后端接口（框架软链到 /usr/ikuai/function/mimon）
#
# 分发链: openresty -> func_api.sh mimon <action> k=v...
#   * action 必须是 name() 形式
#   * 参数值不能带空格/引号；自由文本里的空格前端用 '+' 传，这里还原
#   * show 会把 __json_result__ 包成 {"Result":30000,"Data":{...}}

MROOT="/etc/mnt/plugins/mimon"
BIN="$MROOT/bin/mimon"
MLOG=/etc/log/mimon.log

__show_data() {
    local status devices events
    status="$("$BIN" status 2>>"$MLOG")"
    [ -n "$status" ] || status='{}'
    devices="$("$BIN" devices 2>>"$MLOG")"
    [ -n "$devices" ] || devices='[]'
    events="$("$BIN" events 30 2>>"$MLOG")"
    [ -n "$events" ] || events='[]'
    json_append __json_result__ status:json
    json_append __json_result__ devices:json
    json_append __json_result__ events:json
}

show()
{
    Show __json_result__
}

scan()
{
    local out
    if [ "${sweep:-0}" = "1" ]; then
        out="$("$BIN" scan --sweep 2>>"$MLOG")" || { echo "扫描失败，请查看 $MLOG"; return 1; }
    else
        out="$("$BIN" scan 2>>"$MLOG")" || { echo "扫描失败，请查看 $MLOG"; return 1; }
    fi
    [ -n "$out" ] || out='{}'
    json_append __json_result__ scan:json
    Show __json_result__
}

sweep()
{
    "$BIN" sweep-start >>"$MLOG" 2>&1 || { echo "启动网段扫描失败"; return 1; }
    echo "网段扫描已启动"
}

seting()
{
    local k v
    k="${key:-}"
    v="${value:-}"
    case "$k" in
        interval|offline_after|miio|sweep_enabled|sweep_every|sweep_cidr|retain_events) ;;
        *) echo "不支持的配置项: $k"; return 1 ;;
    esac
    "$BIN" set "$k" "$v" >>"$MLOG" 2>&1 || { echo "保存失败：取值不合法"; return 1; }
    echo "已保存"
    return 0
}

rename()
{
    local m n k
    m="${mac:-}"
    n="$(printf '%s' "${name:-}" | tr '+' ' ')"
    k="${kind:-auto}"
    "$BIN" edit "$m" "$n" "$k" >>"$MLOG" 2>&1 || { echo "保存失败：设备不存在或参数不合法"; return 1; }
    echo "已保存"
    return 0
}

add()
{
    local m n k
    m="${mac:-}"
    n="$(printf '%s' "${name:-}" | tr '+' ' ')"
    k="${kind:-auto}"
    "$BIN" add "$m" "$n" "$k" >>"$MLOG" 2>&1 || { echo "添加失败：MAC 不合法"; return 1; }
    echo "已添加"
    return 0
}

forget()
{
    "$BIN" forget "${mac:-}" >>"$MLOG" 2>&1 || { echo "删除失败：设备不存在"; return 1; }
    echo "已删除"
    return 0
}
