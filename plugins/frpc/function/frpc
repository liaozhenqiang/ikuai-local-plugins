#!/bin/bash /etc/ikcommon
#
# function/frpc —— Web 后端接口(框架软链到 /usr/ikuai/function/frpc)。
#
# 分发链: openresty -> /usr/ikuai/function/func_api.sh frpc <action> k=v...
# 动作: show / start / stop / restart / seting / addproxy / delproxy
# 约定:
#   * 动作必须是 name() 形式(不能以下划线开头), 否则 func_api 判 invalid action
#   * 参数由 ikcommon 的 `Command` 用 `local k=v` 变成局部变量, 所以自定义
#     参数名(name/ptype/lip/lport/rport/domain)可以直接用, 不用解析 $@
#   * show 把数据塞进 __json_result__, 由 Show 包成 {"Result":30000,"Data":{...}}
#   * 失败: 向 stdout 打印错误并 return 1 -> 前端收到 Result=30002
#   * 注意: func_api 对 add/delete 有特殊处理(返回 RowId / 不回传输出), 所以这里
#     用 addproxy / delproxy 这种自定义名, 走默认分支才能把错误回给页面
#
ROOT="/etc/mnt/plugins/frpc"
CLI="$ROOT/bin/frpcctl"

# 用 bash 调用包装器(而不是靠执行位直接执行): 即使 zip 权限位丢失, 后端依然可用
cli() { bash "$CLI" "$@"; }

# 把一段多行文本转成 **带引号的 JSON 字符串**(日志里有 ESC/控制字符/引号, 必须转义)。
# 设备上的 ocd_text 是 openclash 私有的, 不能依赖, 这里自带一份。
json_str() {
    # 控制字符用 awk gsub(/[\001-\037\177]/,"") 删:
    #   * busybox awk 正则里写 \000 会变真 NUL 字节把正则源截断(报 bad regex '[');
    #   * busybox tr 的八进制转义不能做范围端点(\000-\011 的 - 变字面量, 误删 '-');
    #   * 高位字节(中文)不删 —— 老写法 [^\n\040-\176] 会把中文全删掉(之前踩过)。
    printf '%s' "$1" | awk '
        { gsub(/[\001-\037\177]/, "");
          gsub(/\\/, "\\\\"); gsub(/"/, "\\\"");
          printf "%s%s", (NR>1 ? "\\n" : ""), $0 }' | sed -e 's/^/"/' -e 's/$/"/'
}

__show_status() {
    local status
    status="$(cli status 2>/dev/null)"; [ -n "$status" ] || status='{}'
    json_append __json_result__ status:json
}

__show_log() {
    local n="${1:-60}"
    # 变量名必须与键名一致(json_append 按名字取), 写成 txt 会传出空值
    log="$(json_str "$(cli log "$n" 2>&1)")"
    json_append __json_result__ log:json
}

show()
{
    Show __json_result__
}

# 把包装器 stderr 上的失败原因清洗成一行, 直接显示在插件页面上
__reason() {
    printf '%s' "$1" | tr '\n' ' ' | tr -d '"\\' | sed 's/  */ /g' | cut -c1-180
}

start()
{
    local out rc msg
    out="$(cli start 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then echo "已启动"; return 0; fi
    msg="$(__reason "$out")"
    [ -n "$msg" ] || msg="启动失败(无输出, 见 /etc/log/frpc/frpc.log)"
    echo "$msg"; return 1
}

stop()
{
    cli stop >/dev/null 2>&1 && { echo "已停止"; return 0; }
    echo "停止失败"; return 1
}

restart()
{
    local out rc msg
    out="$(cli restart 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then echo "已重启"; return 0; fi
    msg="$(__reason "$out")"
    [ -n "$msg" ] || msg="重启失败(无输出, 见 /etc/log/frpc/frpc.log)"
    echo "$msg"; return 1
}

# 页面上的"单行输入 + 保存"都走这里(与 frps 插件保持一致)
seting()
{
    local out
    case "$key" in
        serveraddr)
            # 允许留空(清空); 只挡危险字符
            case "$value" in *'"'*|*'\'*|*'|'*) echo "地址不能含引号、反斜杠或竖线"; return 1 ;; esac
            out="$(cli serveraddr "$value" 2>&1)" || { echo "${out:-修改失败}"; return 1; }
            echo "${out:-已保存}"; return 0 ;;
        serverport|webport)
            case "$value" in ''|*[!0-9]*) echo "端口必须是数字"; return 1 ;; esac
            [ "$value" -ge 1 ] && [ "$value" -le 65535 ] || { echo "端口需在 1~65535 之间"; return 1; }
            case "$value" in 80|443) echo "80/443 被 iKuai 控制台占用, 请换端口"; return 1 ;; esac
            out="$(cli "$key" "$value" 2>&1)" || { echo "${out:-修改失败}"; return 1; }
            echo "${out:-已保存}"; return 0 ;;
        token)
            # 允许留空(frps 没设 token 时这里也要空)
            case "$value" in *'"'*|*'\'*|*'|'*) echo "Token 不能含引号、反斜杠或竖线"; return 1 ;; esac
            out="$(cli token "$value" 2>&1)" || { echo "${out:-修改失败}"; return 1; }
            echo "${out:-已保存}"; return 0 ;;
        webuser|webpass)
            case "$value" in ''|-*) echo "不能为空, 且不能以 - 开头"; return 1 ;; esac
            case "$value" in *'"'*|*'\'*) echo "不能含引号或反斜杠"; return 1 ;; esac
            out="$(cli "$key" "$value" 2>&1)" || { echo "${out:-修改失败}"; return 1; }
            echo "${out:-已保存}"; return 0 ;;
        autostart)
            # 只写开关, 不动当前运行状态、也不重启(改"下次开机行为"而已)
            case "$value" in
                0|1) cli autostart "$value" >/dev/null 2>&1 || { echo "保存失败"; return 1; }
                     echo "已保存"; return 0 ;;
                *)   echo "取值必须是 0 或 1"; return 1 ;;
            esac
            ;;
        *)
            echo "不支持的配置项: $key"; return 1 ;;
    esac
}

# 新增/覆盖一条代理规则。参数由 ikcommon 直接注入成局部变量, 名字与页面保持一致:
#   name ptype lip lport rport domain
addproxy()
{
    local out
    case "$name" in ''|*[!A-Za-z0-9_.-]*) echo "规则名只能是字母数字 _ . - , 且不能为空"; return 1 ;; esac
    case "$ptype" in tcp|udp|http|https) : ;; *) echo "类型必须是 tcp/udp/http/https"; return 1 ;; esac
    case "$lip"   in ''|*[!0-9A-Za-z._:-]*) echo "内网地址含非法字符"; return 1 ;; esac
    case "$lport" in ''|*[!0-9]*) echo "内网端口必须是数字"; return 1 ;; esac
    case "$ptype" in
        http|https)
            case "$domain" in ''|*[!0-9A-Za-z.*-]*) echo "http/https 必须填域名"; return 1 ;; esac
            rport=0 ;;
        *)
            case "$rport" in ''|*[!0-9]*) echo "远程端口必须是数字"; return 1 ;; esac
            [ "$rport" -ge 1 ] && [ "$rport" -le 65535 ] || { echo "远程端口需在 1~65535 之间"; return 1; }
            domain="" ;;
    esac
    [ "$lport" -ge 1 ] && [ "$lport" -le 65535 ] || { echo "内网端口需在 1~65535 之间"; return 1; }
    out="$(cli proxy-add "$name" "$ptype" "$lip" "$lport" "$rport" "$domain" 2>&1)" || {
        echo "${out:-保存失败}"; return 1; }
    echo "${out:-规则已保存}"
    return 0
}

# 删除一条代理规则
delproxy()
{
    local out
    case "$name" in ''|*[!A-Za-z0-9_.-]*) echo "规则名不合法"; return 1 ;; esac
    out="$(cli proxy-del "$name" 2>&1)" || { echo "${out:-删除失败}"; return 1; }
    echo "${out:-已删除}"
    return 0
}

logclear()
{
    cli logclear >/dev/null 2>&1 && { echo "已清空"; return 0; }
    echo "清空失败"; return 1
}
