#!/bin/bash
#
# frpcctl —— frp 客户端(frpc) 控制器(纯 shell)
#
# 框架会把 pkg/bin/* 软链到 /usr/sbin/ 并去掉 .sh 后缀, 设备上直接 `frpcctl <命令>`。
#
# 命令:
#   start [nowait] | stop | restart    启停(幂等; nowait 给开机用)
#   status | status-json               人类可读 / JSON 状态
#   serveraddr <IP或域名>              frps 的地址(必填, 空则拒绝启动)
#   serverport <1-65535>               frps 的通信端口(默认 7000)
#   token <token>                      与 frps 一致的认证 Token
#   webport <1-65535>                  本地管理界面端口(默认 7400)
#   webuser <用户名>                   管理界面登录名
#   webpass <新密码>                   管理界面密码
#   proxy-add <name> <type> <localIP> <localPort> <remotePort> <domain>
#                                      新增/覆盖一条代理规则(同名即覆盖)
#   proxy-del <name>                   删除一条代理规则
#   proxy-list                         列出所有规则(竖线分隔, 供脚本用)
#   proxy-json                         规则列表的 JSON 数组
#   autostart <0|1>                    开机自启
#   extra <附加配置>                   原样追加到 frpc.toml(高级用法)
#   log [行数]                         查看运行日志
#   logclear                          清空运行日志
#   ensure                             确保目录与配置就位(不启动)
#   version                            版本
#
# 真机实测结论(改之前先看):
#   * frp v0.71.1 的 frpc 是 Go **静态 ELF**, uClibc 1.0.40 设备直接跑, RSS 约 22MB。
#   * 配置是 **TOML**(v0.71 起, 不再是 ini), 且 `--strict-config` 默认开启 ——
#     未知字段直接报错退出。顶层 serverAddr/serverPort, 段: [auth] token、
#     [webServer] addr/port/user/**password**、[log] to/level/maxDays,
#     代理是 **[[proxies]]** 数组段(name/type/localIP/localPort/remotePort,
#     http(s) 用 customDomains=[...])。
#   * frpc **不写 pid 文件**, 控制器自己维护(见 pid_alive 的 cmdline 校验)。
#   * 改任何配置都要"先停 -> 写配置 -> 再起": 配置只在启动时读一次。
#   * serverAddr 为空时 frpc 会启动即退出, 所以 start 前先挡一道, 免得陷进
#     "启动失败但没说为什么"。
#
set -u

SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
ROOT="${PLUGIN_DIR:-$(cd "$(dirname "$SELF")/.." && pwd)}"
BIN="$ROOT/share/frpc"                 # 大二进制放 share/ —— 框架不软链这个目录
DATA="$ROOT/data"
PIDF="$DATA/frpc.pid"
STARTF="$DATA/frpc.start"
CTLCONF="$DATA/frpcctl.conf"           # 我们自己的开关, 不写进 frpc.toml
PROXIES="$DATA/proxies.list"           # 代理规则库: name|type|localIP|localPort|remotePort|domain
CONF="$DATA/frpc.toml"
LOG=/etc/log/frpc/frpc.log
DEF_SERVERPORT=7000
DEF_WEBPORT=7400
DEF_VER="0.71.1"

have() { command -v "$1" >/dev/null 2>&1; }
oc_log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }

ensure_dirs() {
    mkdir -p "$DATA" "$(dirname "$LOG")" 2>/dev/null
    test -f "$PROXIES" || : > "$PROXIES" 2>/dev/null
    return 0
}

cfg_get() { sed -n "s/^$1=//p" "$CTLCONF" 2>/dev/null | head -n1; }
cfg_set() {
    local k="$1" v="$2"
    test -f "$CTLCONF" || : > "$CTLCONF" 2>/dev/null
    if grep -q "^$k=" "$CTLCONF" 2>/dev/null; then
        sed -i "s|^$k=.*|$k=$v|" "$CTLCONF" 2>/dev/null
    else
        printf '%s=%s\n' "$k" "$v" >> "$CTLCONF" 2>/dev/null
    fi
}

num_get() {  # num_get <键> <默认值>
    local v
    v="$(cfg_get "$1")"
    case "$v" in ''|*[!0-9]*) v="$2" ;; esac
    printf '%s' "$v"
}
serverport_get() { num_get serverport "$DEF_SERVERPORT"; }
webport_get()    { num_get webport    "$DEF_WEBPORT"; }
serveraddr_get() { cfg_get serveraddr; }

# 随机串: 6 字节 /dev/urandom 的十六进制(设备上没有 od/xxd, 用 hexdump -C 再抠)
rand_hex() {
    head -c 6 /dev/urandom 2>/dev/null | hexdump -C 2>/dev/null | \
        awk '{sub(/\|.*/,"");sub(/^[^ ]+ */,"");gsub(/ /,"");printf "%s",$0}'
}

webuser_get() {
    local v
    v="$(cfg_get webuser)"
    printf '%s' "${v:-admin}"
}
webpass_get() {
    local v
    v="$(cfg_get webpass)"
    if [ -z "$v" ]; then
        v="$(rand_hex)"
        [ -n "$v" ] || v="frp$(date +%s | tail -c 6)"
        cfg_set webpass "$v"
    fi
    printf '%s' "$v"
}

# 只认 0/1, 默认开 —— 装完就该能用(前提是把服务端地址填了)
autostart_get() {
    case "$(cfg_get autostart)" in
        0) printf '0' ;;
        *) printf '1' ;;
    esac
}

ver_get() {
    local v
    v="$("$BIN" -v 2>/dev/null | head -n1 | awk '{print $1}')"
    printf '%s' "${v:-$DEF_VER}"
}

# 日志超过 1MB 只留最后 1000 行
log_trim() {
    local kb
    kb="$(du -k "$LOG" 2>/dev/null | awk '{print $1}')"
    case "$kb" in ''|*[!0-9]*) return 0 ;; esac
    if test "$kb" -gt 1024; then
        tail -n 1000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG" 2>/dev/null
        oc_log "[log] 日志过大($kb KB), 已裁剪"
    fi
    return 0
}

# 存活 = pid 文件在 + 进程在 + cmdline 里确实是我们的二进制(防 pid 复用)
pid_alive() {
    local p
    test -f "$PIDF" || return 1
    p="$(cat "$PIDF" 2>/dev/null)"
    case "$p" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$p" 2>/dev/null || return 1
    if test -r "/proc/$p/cmdline"; then
        case "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" in
            *"$BIN"*) : ;;
            *) return 1 ;;
        esac
    fi
    return 0
}

# 端口是否已被"别的进程"占用(自己占用不算)
port_busy_others() {
    local p="$1" self line pid
    have netstat || return 1
    self="$(cat "$PIDF" 2>/dev/null)"
    line="$(netstat -tlnp 2>/dev/null | awk -v pt=":$p\$" '$4 ~ pt {print $NF; exit}')"
    case "$line" in ''|'-'*) return 1 ;; esac
    pid="${line%%/*}"
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    test "$pid" = "$self" && return 1
    return 0
}

# 端口真的在应答了才算"就绪"(进程死了立即返回, 不傻等)
port_ready() {
    local p="$1" i=0
    if ! have curl; then return 0; fi
    while test "$i" -lt 30; do
        if ! pid_alive; then
            oc_log "[start] 进程已退出, 启动失败"
            return 1
        fi
        if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$p/" 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

plain() { sed 's/\x1b\[[0-9;]*[A-Za-z]//g' 2>/dev/null; }
tailerr() { tail -n 3 "$LOG" 2>/dev/null | plain | tr '\n' ' ' | cut -c1-180; }

# ------------------------------------------------------------- 代理规则

# 规则名合法性: 只放行 字母数字 _ . - ; 空则整条规则会被跳过
proxy_name_ok() {
    case "${1:-}" in
        '') return 1 ;;
        *[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    return 0
}

# 规则名 -> 正则安全串(名字里可以有 '.', 不转义会误删别的规则)
re_esc() { printf '%s' "$1" | sed 's/[.[\*^$+?(){}]/\\&/g'; }

proxy_count() {
    local n
    n="$(grep -c '[^[:space:]]' "$PROXIES" 2>/dev/null)"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    printf '%s' "$n"
}

# ------------------------------------------------------------- 配置生成

# 由当前设置 + 规则库生成 frpc.toml。v0.71 是 TOML 且严格模式, 段名/字段名写错会起不来。
gen_conf() {
    local sa sp tok wp wu wpx extra name ptype lip lp rp dom
    sa="$(serveraddr_get)"
    sp="$(serverport_get)"
    tok="$(cfg_get token)"
    wp="$(webport_get)"
    wu="$(webuser_get)"
    wpx="$(webpass_get)"
    {
        printf 'serverAddr = "%s"\n' "$sa"
        printf 'serverPort = %s\n' "$sp"
        if [ -n "$tok" ]; then
            printf '\n[auth]\ntoken = "%s"\n' "$tok"
        fi
        printf '\n[webServer]\n'
        printf 'addr = "0.0.0.0"\n'
        printf 'port = %s\n' "$wp"
        printf 'user = "%s"\n' "$wu"
        printf 'password = "%s"\n' "$wpx"
        printf '\n[log]\n'
        printf 'to = "%s"\n' "$LOG"
        printf 'level = "info"\n'
        printf 'maxDays = 3\n'
        # ---- 代理规则 ----
        while IFS='|' read -r name ptype lip lp rp dom; do
            [ -n "$name" ] || continue
            printf '\n[[proxies]]\n'
            printf 'name = "%s"\n' "$name"
            printf 'type = "%s"\n' "$ptype"
            printf 'localIP = "%s"\n' "$lip"
            printf 'localPort = %s\n' "$lp"
            case "$ptype" in
                http|https)
                    [ -n "$dom" ] && printf 'customDomains = ["%s"]\n' "$dom"
                    ;;
                *)
                    [ -n "$rp" ] && [ "$rp" != "0" ] && printf 'remotePort = %s\n' "$rp"
                    ;;
            esac
        done < "$PROXIES"
        extra="$(cfg_get extra)"
        if [ -n "$extra" ]; then
            printf '\n# --- 附加配置(用户自定义, 原样追加) ---\n'
            printf '%s\n' "$extra"
        fi
    } > "$CONF.tmp" 2>/dev/null && mv -f "$CONF.tmp" "$CONF" 2>/dev/null
    chmod 600 "$CONF" 2>/dev/null
    return 0
}

cmd_init() {
    ensure_dirs
    log_trim
    # 自愈: 补回自身与真实二进制的执行位(框架只 chmod function/, 不管 bin/ 与 share/)
    chmod +x "$SELF" "$BIN" 2>/dev/null
    test -s "$CONF" || gen_conf
    return 0
}

# ------------------------------------------------------------- 启停

cmd_start() {
    local sa sp wp
    test -x "$BIN" || { echo "缺少 frpc 程序: $BIN"; return 1; }
    cmd_init
    if pid_alive; then
        echo "frpc 已在运行 pid=$(cat "$PIDF")"
        return 0
    fi
    sa="$(serveraddr_get)"
    if [ -z "$sa" ]; then
        echo "还没填服务端地址 —— 请先在页面填 frps 的 IP/域名(serverAddr)"; return 1
    fi
    sp="$(serverport_get)"
    wp="$(webport_get)"
    if port_busy_others "$wp"; then
        echo "管理界面端口 $wp 已被其它进程占用, 请换一个"; return 1
    fi
    # 没有 nohup/setsid: 子 shell + 忽略 HUP; exec 让 $! 就是最终进程 pid
    ( trap '' HUP; cd "$DATA" || exit 1; exec "$BIN" -c "$CONF" ) >> "$LOG" 2>&1 &
    printf '%s' "$!" > "$PIDF" 2>/dev/null
    date +%s > "$STARTF" 2>/dev/null
    oc_log "[start] pid=$(cat "$PIDF" 2>/dev/null) server=$sa:$sp web=$wp 规则=$(proxy_count) 条"
    if test "${1:-}" = "nowait"; then
        echo "frpc 已启动 pid=$(cat "$PIDF")"
        return 0
    fi
    if port_ready "$wp"; then
        echo "frpc 已启动 pid=$(cat "$PIDF") 服务端=$sa:$sp 管理界面=$wp"
        return 0
    fi
    echo "frpc 启动失败(管理界面 $wp 未就绪): $(tailerr)"
    return 1
}

cmd_stop() {
    local p i=0
    if test -f "$PIDF"; then
        p="$(cat "$PIDF" 2>/dev/null)"
        kill "$p" 2>/dev/null
    fi
    # 兜底: pid 文件丢了也要按二进制路径把残留进程清掉
    for p in $(ps 2>/dev/null | grep -- "$BIN" | grep -v grep | awk '{print $1}'); do
        kill "$p" 2>/dev/null
    done
    while test "$i" -lt 15; do
        test -z "$(ps 2>/dev/null | grep -- "$BIN" | grep -v grep)" && break
        i=$((i + 1))
        sleep 1
    done
    rm -f "$PIDF" "$STARTF" 2>/dev/null
    oc_log "[stop] 已停止"
    echo "frpc 已停止"
    return 0
}

cmd_restart() {
    cmd_stop >/dev/null 2>&1
    sleep 1
    cmd_start "${1:-wait}"
}

# ------------------------------------------------------------- 状态

json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

lan_ip() {
    local i
    i="$(ip -o -4 addr show 2>/dev/null | \
         awk '$4 ~ /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/ {sub(/\/.*/,"",$4); print $4; exit}')"
    printf '%s' "${i:-127.0.0.1}"
}

# 规则库 -> JSON 数组
proxies_json() {
    local out="[" first=1 name ptype lip lp rp dom
    while IFS='|' read -r name ptype lip lp rp dom; do
        [ -n "$name" ] || continue
        test "$first" = 1 || out="$out,"
        first=0
        out="$out{\"name\":\"$(json_esc "$name")\",\"type\":\"$(json_esc "$ptype")\""
        out="$out,\"localIP\":\"$(json_esc "$lip")\",\"localPort\":${lp:-0},\"remotePort\":${rp:-0}"
        out="$out,\"domain\":\"$(json_esc "$dom")\"}"
    done < "$PROXIES"
    printf '%s]' "$out"
}

cmd_status_json() {
    local sa sp wp tok wu wpx running=false pid=0 up=0 ver="" ip wcode=""
    test -x "$BIN" || {
        printf '{"installed":false,"running":false,"error":"缺少 frpc 程序, 请重新安装插件"}\n'
        return 0
    }
    ensure_dirs
    sa="$(serveraddr_get)"
    sp="$(serverport_get)"
    wp="$(webport_get)"
    tok="$(cfg_get token)"
    wu="$(webuser_get)"
    wpx="$(webpass_get)"
    if pid_alive; then
        running=true
        pid="$(cat "$PIDF" 2>/dev/null)"
        if test -f "$STARTF"; then
            up=$(( $(date +%s) - "$(cat "$STARTF" 2>/dev/null)" ))
        fi
        case "$up" in ''|*[!0-9]*) up=0 ;; esac
        test "$up" -lt 0 && up=0
    fi
    ver="$(ver_get)"
    ip="$(lan_ip)"
    # 进程活着 != 管理界面在听: 本地探一次, 401 说明在(要登录), 000 表示没监听
    if test "$running" = true && have curl; then
        wcode="$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$wp/" 2>/dev/null)"
    fi
    printf '{"installed":true,"running":%s,"pid":%s,"uptime":%s,"server_addr":"%s","server_port":%s,' \
        "$running" "${pid:-0}" "${up:-0}" "$(json_esc "$sa")" "$sp"
    printf '"webport":%s,"web_code":"%s","version":"%s","web_url":"http://%s:%s/","web_user":"%s","web_pass":"%s",' \
        "$wp" "$wcode" "$(json_esc "$ver")" "$ip" "$wp" "$(json_esc "$wu")" "$(json_esc "$wpx")"
    printf '"token":"%s","autostart":%s,"proxy_count":%s,"proxies":%s}\n' \
        "$(json_esc "$tok")" "$(autostart_get)" "$(proxy_count)" "$(proxies_json)"
    return 0
}

cmd_status() { cmd_status_json; }

# 改配置通用逻辑: 先停 -> 写 conf -> 重新生成 -> 再起 -> 失败回滚
_reload_after_set() {
    local key="$1" old="$2" was="$3" label="$4"
    if test "$was" = yes; then
        if cmd_start wait >/dev/null 2>&1; then
            oc_log "[$key] 已修改"
            echo "$label 已修改并重启"
            return 0
        fi
        cfg_set "$key" "$old"
        gen_conf
        cmd_start wait >/dev/null 2>&1
        oc_log "[$key] 修改失败, 已回滚"
        echo "重启失败, 已恢复原值($old): $(tailerr)"
        return 1
    fi
    oc_log "[$key] 已修改(未运行, 下次启动生效)"
    echo "$label 已修改(下次启动生效)"
    return 0
}

# 数值型设置(serverport / webport)
_setnum() {
    local key="$1" val="$2" def="$3" label="$4" old was=no
    case "$val" in
        ''|*[!0-9]*) echo "端口必须是数字"; return 1 ;;
    esac
    if test "$val" -lt 1 || test "$val" -gt 65535; then
        echo "端口需在 1~65535 之间"; return 1
    fi
    case "$val" in 80|443) echo "80/443 被 iKuai 控制台占用, 请换端口"; return 1 ;; esac
    ensure_dirs
    old="$(num_get "$key" "$def")"
    pid_alive && was=yes
    if test "$val" = "$old"; then
        echo "端口未变化($val)"; return 0
    fi
    if test "$key" = webport && port_busy_others "$val"; then
        echo "端口 $val 已被其它进程占用, 请换一个"; return 1
    fi
    if test "$was" = yes; then cmd_stop >/dev/null 2>&1; fi
    cfg_set "$key" "$val"
    gen_conf
    _reload_after_set "$key" "$old" "$was" "$label"
}

# 字符串型设置(serveraddr / token / webuser / webpass)
_setstr() {
    local key="$1" val="$2" label="$3" old was=no
    if test "$key" != serveraddr; then
        test -n "$val" || { echo "$label 不能为空"; return 1; }
    fi
    case "$val" in -*|*' '*) echo "$label 不能以 - 开头、不能含空格"; return 1 ;; esac
    if printf '%s\n' "$val" | grep -q '[^0-9A-Za-z!@#$%^*()_+.,:;<>?/~{}-]'; then
        echo "$label 含不允许的字符(不能有引号、反斜杠、方括号)"; return 1
    fi
    ensure_dirs
    old="$(cfg_get "$key")"
    pid_alive && was=yes
    if test "$was" = yes; then cmd_stop >/dev/null 2>&1; fi
    cfg_set "$key" "$val"
    gen_conf
    _reload_after_set "$key" "$old" "$was" "$label"
}

cmd_serveraddr() { _setstr serveraddr "${1:-}" "服务端地址"; }
cmd_serverport() { _setnum  serverport "${1:-}" "$DEF_SERVERPORT" "服务端端口"; }
cmd_webport()    { _setnum  webport    "${1:-}" "$DEF_WEBPORT"     "管理界面端口"; }
cmd_webuser()    { _setstr  webuser    "${1:-}" "管理界面用户名"; }
cmd_webpass()    { _setstr  webpass    "${1:-}" "管理界面密码"; }

# token: 允许清空(frps 没设 token 时这里也要空); 留空时按空处理
cmd_token() {
    local v="${1:-}" old was=no
    case "$v" in -*|*' '*) echo "Token 不能以 - 开头、不能含空格"; return 1 ;; esac
    if printf '%s\n' "$v" | grep -q '[^0-9A-Za-z!@#$%^*()_+.,:;<>?/~{}-]'; then
        echo "Token 含不允许的字符(不能有引号、反斜杠、方括号)"; return 1
    fi
    ensure_dirs
    old="$(cfg_get token)"
    pid_alive && was=yes
    if test "$was" = yes; then cmd_stop >/dev/null 2>&1; fi
    cfg_set token "$v"
    gen_conf
    _reload_after_set token "$old" "$was" "认证 Token"
}

cmd_extra() {
    local v="${1:-}"
    if [ -z "$v" ]; then
        cfg_set extra ""
        gen_conf
        echo "附加配置已清空"; return 0
    fi
    case "$v" in *'"'*|*'\'*) echo "不能含引号或反斜杠"; return 1 ;; esac
    cfg_set extra "$v"
    gen_conf
    echo "附加配置已保存"
    return 0
}

cmd_autostart() {
    case "${1:-}" in
        0|1) cfg_set autostart "$1"
             echo "开机自启: $(test "$1" = 1 && echo 开启 || echo 关闭)"; return 0 ;;
        # 不带参数 = 查询。boot.sh 依赖它判断要不要拉起, 别改成打印用法
        '')  autostart_get; return 0 ;;
        *)   echo "用法: frpcctl autostart <0|1>"; return 1 ;;
    esac
}

# ------------------------------------------------------------- 代理规则增删

# proxy-add <name> <type> <localIP> <localPort> <remotePort> <domain>
cmd_proxy_add() {
    local name="${1:-}" ptype="${2:-}" lip="${3:-}" lp="${4:-}" rp="${5:-}" dom="${6:-}"
    local was=no tmp
    ensure_dirs
    proxy_name_ok "$name" || { echo "规则名只能是字母数字 _ . - , 且不能为空"; return 1; }
    case "$ptype" in
        tcp|udp|http|https) : ;;
        *) echo "类型必须是 tcp / udp / http / https"; return 1 ;;
    esac
    case "$lip" in
        ''|*[!0-9A-Za-z._:-]*) echo "内网地址/IP 含非法字符"; return 1 ;;
    esac
    case "$lp" in
        ''|*[!0-9]*) echo "内网端口必须是数字"; return 1 ;;
    esac
    if test "$lp" -lt 1 || test "$lp" -gt 65535; then echo "内网端口需在 1~65535"; return 1; fi
    case "$ptype" in
        http|https)
            case "$dom" in
                ''|*[!0-9A-Za-z.*-]*) echo "http/https 必须填域名(customDomains)"; return 1 ;;
            esac
            rp=0 ;;
        *)
            dom=""
            case "$rp" in
                ''|*[!0-9]*) echo "远程端口必须是数字"; return 1 ;;
            esac
            if test "$rp" -lt 1 || test "$rp" -gt 65535; then echo "远程端口需在 1~65535"; return 1; fi ;;
    esac

    # 同名覆盖: 先把旧行剔掉再加(避免 [[proxies]] 重名导致 frpc 拒绝)
    tmp="$PROXIES.tmp"
    grep -v "^$(re_esc "$name")|" "$PROXIES" 2>/dev/null > "$tmp" 2>/dev/null
    printf '%s|%s|%s|%s|%s|%s\n' "$name" "$ptype" "$lip" "$lp" "$rp" "$dom" >> "$tmp" 2>/dev/null
    mv -f "$tmp" "$PROXIES" 2>/dev/null

    pid_alive && was=yes
    if test "$was" = yes; then cmd_stop >/dev/null 2>&1; fi
    gen_conf
    if test "$was" = yes; then
        if cmd_start wait >/dev/null 2>&1; then
            oc_log "[proxy-add] $name $ptype $lip:$lp -> $rp $dom"
            echo "规则 $name 已保存并重启"
            return 0
        fi
        # 回滚: 撤掉刚加的规则
        grep -v "^$(re_esc "$name")|" "$PROXIES" 2>/dev/null > "$tmp" 2>/dev/null
        mv -f "$tmp" "$PROXIES" 2>/dev/null
        gen_conf
        cmd_start wait >/dev/null 2>&1
        echo "重启失败, 已撤销规则 $name: $(tailerr)"
        return 1
    fi
    oc_log "[proxy-add] $name $ptype $lip:$lp -> $rp $dom (未运行)"
    echo "规则 $name 已保存(服务未运行, 下次启动生效)"
    return 0
}

cmd_proxy_del() {
    local name="${1:-}" was=no tmp
    ensure_dirs
    proxy_name_ok "$name" || { echo "规则名不合法"; return 1; }
    grep -q "^$(re_esc "$name")|" "$PROXIES" 2>/dev/null || { echo "没有这条规则: $name"; return 1; }
    tmp="$PROXIES.tmp"
    grep -v "^$(re_esc "$name")|" "$PROXIES" 2>/dev/null > "$tmp" 2>/dev/null
    mv -f "$tmp" "$PROXIES" 2>/dev/null
    pid_alive && was=yes
    if test "$was" = yes; then cmd_stop >/dev/null 2>&1; fi
    gen_conf
    if test "$was" = yes; then
        cmd_start wait >/dev/null 2>&1
        oc_log "[proxy-del] $name"
        echo "规则 $name 已删除并重启"
        return 0
    fi
    oc_log "[proxy-del] $name (未运行)"
    echo "规则 $name 已删除"
    return 0
}

cmd_proxy_list() { ensure_dirs; cat "$PROXIES" 2>/dev/null; }
cmd_proxy_json() { ensure_dirs; proxies_json; }

cmd_log() {
    local n="${1:-60}"
    case "$n" in ''|*[!0-9]*) n=60 ;; esac
    log_trim
    tail -n "$n" "$LOG" 2>/dev/null || echo "(暂无日志)"
}

cmd_version() { ver_get; }

cmd_logclear() {
    : > "$LOG" 2>/dev/null
    oc_log "[log] 日志已清空"
    echo "已清空"
}

case "${1:-}" in
    init)         cmd_init ;;
    start)        shift; cmd_start "${1:-wait}" ;;
    start-nowait) cmd_start nowait ;;
    stop)         cmd_stop ;;
    restart)      shift; cmd_restart "${1:-wait}" ;;
    status)       cmd_status ;;
    status-json)  cmd_status_json ;;
    serveraddr)   shift; cmd_serveraddr "${1:-}" ;;
    serverport)   shift; cmd_serverport "${1:-}" ;;
    token)        shift; cmd_token "${1:-}" ;;
    webport)      shift; cmd_webport "${1:-}" ;;
    webuser)      shift; cmd_webuser "${1:-}" ;;
    webpass)      shift; cmd_webpass "${1:-}" ;;
    extra)        shift; cmd_extra "${1:-}" ;;
    autostart)    shift; cmd_autostart "${1:-}" ;;
    proxy-add)    shift; cmd_proxy_add "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
    proxy-del)    shift; cmd_proxy_del "${1:-}" ;;
    proxy-list)   cmd_proxy_list ;;
    proxy-json)   cmd_proxy_json ;;
    log)          shift; cmd_log "${1:-60}" ;;
    logclear)     cmd_logclear ;;
    ensure)       ensure_dirs; log_trim; echo "目录与配置已就位" ;;
    version)      cmd_version ;;
    *)             sed -n '3,43p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
